{
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite",
    "build": "deno run -A --node-modules-dir npm:vite build",
    "preview": "deno run -A --node-modules-dir npm:vite preview",
    "serve": "deno run --allow-net --allow-read jsr:@std/http@1/file-server dist/",
    "crawl": "scripts/crawl-data.ts",
  },
  "fmt": {
    "semiColons": false,
    "proseWrap": "never",
    "json.trailingCommas": "jsonc",
  },
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.5",
    "@preact/preset-vite": "npm:@preact/preset-vite@^2.10.2",
    "@preact/signals": "npm:@preact/signals@^2.3.1",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@types/d3": "npm:@types/d3@^7.4.3",
    "d3": "npm:d3@^7.9.0",
    "node-html-parser": "npm:node-html-parser@^6.1.13",
    "preact": "npm:preact@^10.28.0",
    "vite": "npm:vite@^7.2.7",
  },
}
